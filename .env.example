# Example environment variables for local development
# Copy this to .env and fill values before running the backend

# MongoDB
MONGODB_URI=mongodb://localhost:27017/campus_marketplace
MONGODB_DB_NAME=campus_marketplace

# JWT
JWT_SECRET=change-me-in-dev

# Frontend origin (optional)
FRONTEND_ORIGIN=http://localhost:5173

# SendGrid (preferred)
# Sign up for SendGrid, create an API key with Mail Send permission, and paste it here.
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM=your_verified_sender_email

# SMTP fallback (if not using SendGrid)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
EMAIL_FROM=you@example.com

# Cloudinary (optional for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=campus-marketplace

# OTP and resend config (optional)
OTP_TTL_SECONDS=600
RESEND_COOLDOWN_SECONDS=120
